SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
# Server-only (Supabase > Project Settings > API > service_role). Never prefix with VITE_
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Resend.com Email Configuration
# 1. Get your API Key from https://resend.com/api-keys and paste it below or in Vercel Environment Variables:
RESEND_API_KEY=

# 2. Sender Email (Using verified domain tomsbarber.website)
RESEND_FROM_EMAIL=
VITE_RESEND_FROM_EMAIL=

# 3. Barber Shop Owner Email (Receives immediate notification alerts for every new booking)
SHOP_OWNER_EMAIL=
VITE_SHOP_OWNER_EMAIL=
